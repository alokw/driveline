# -----------------------------------------------------------------------------
AUTOMATION_OSC_OUT_ADDRESS=10.10.10.255
AUTOMATION_OSC_OUT_PORT=7411
D3_OSC_OUT_ADDRESS=10.10.10.255
D3_OSC_OUT_PORT=7500
