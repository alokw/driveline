# -----------------------------------------------------------------------------
# Show Configuration
# -----------------------------------------------------------------------------
SHOW_CLOSE=2026-04-12T20:00:00
SEQ_TIME_DRONE_DEPLOY=00:00:30:00
SEQ_TIME_ACT2_START=00:04:46:01
SEQ_TIME_PRESENTER_START=00:10:31:06
SEQ_TIME_PRESENTER_END=00:14:31:06
SEQ_TIME_RESET_START=01:17:46:05
SEQ_TIME_RESET_END=01:19:31:05
SEQ_TIME_TIMELINE_END=01:29:29.29

# -----------------------------------------------------------------------------
# OSC Configuration - Incoming Ports
