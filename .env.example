# -----------------------------------------------------------------------------
# HTTP Integration Configuration
# -----------------------------------------------------------------------------
STAGETIMER_OUT_URL=http://10.19.53.21:3000/api/v1/
STAGETIMER_OUT_SUFFIX=?room_id=UATZFPKH&api_key=b7749fdec5608634eee2801fa0f59324&index=1
EVENTMASTER_OUT_ADDRESS=http://192.168.0.175:9999

# -----------------------------------------------------------------------------
# Google Sheets Configuration
# -----------------------------------------------------------------------------
GOOGLE_SPREADSHEET_ID=1dOrHURyT1WCruuSJ5btp0oBK-x81SQtZozAou_g8Pj4

# Cell range format - use double quotes outer, single quotes inner for spaces:
GOOGLE_SPREADSHEET_CELLS="'control log'!A:D"
# Alternative formats (if sheet name has no spaces):
# GOOGLE_SPREADSHEET_CELLS="Sheet1!A:D"
# GOOGLE_SPREADSHEET_CELLS="control_log!A:D"

# Google Credentials - Paste the entire JSON content from your service account file
# Get this from: Google Cloud Console → IAM & Admin → Service Accounts → Create Key → JSON
# Example: GOOGLE_CREDENTIALS_JSON='{"type": "service_account", "project_id": "...", ...}'
GOOGLE_CREDENTIALS_JSON='{"type": "service_account", "project_id": "your-project-id", "private_key_id": "...", "private_key": "...", "client_email": "...", "client_id": "...", "auth_uri": "https://accounts.google.com/o/oauth2/auth", "token_uri": "https://oauth2.googleapis.com/token", "auth_provider_x509_cert_url": "https://www.googleapis.com/oauth2/v1/certs", "client_x509_cert_url": "..."}'

# -----------------------------------------------------------------------------
# Optional: Flask Configuration
# -----------------------------------------------------------------------------
FLASK_ENV=development
FLASK_DEBUG=1
FLASK_HOST=0.0.0.0                    # Bind to all interfaces (use 127.0.0.1 for localhost only)
FLASK_PORT=5000                        # Port to listen on
SECRET_KEY=change-this-to-a-random-secret-key

# -----------------------------------------------------------------------------
# Optional: OSC Rate Limiting
# -----------------------------------------------------------------------------
# OSC_SEND_INTERVAL=0.01  # Minimum seconds between OSC messages (default: 0.01)
# OSC_QUEUE_SIZE=1000     # Max queue size for outgoing OSC (default: 1000)
